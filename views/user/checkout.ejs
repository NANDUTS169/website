  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editAddressModalLabel">Edit Address</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="editAddressForm">
          <input type="hidden" id="editAddressId" name="addressId" />
          <div class="row g-3">
            <div class="col-md-6">
              <label for="editAddressType" class="form-label">Address Type</label>
              <select class="form-select" id="editAddressType" name="addressType" required>
                <option value="home">Home Address</option>
                <option value="work">Work Address</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="col-md-6">
              <label for="editFullName" class="form-label">Full Name</label>
              <input type="text" class="form-control" id="editFullName" name="fullName" required>
            </div>
          </div>

          <div class="row g-3 mt-2">
            <div class="col-12">
              <label for="editStreetAddress" class="form-label">Street Address</label>
              <input type="text" class="form-control" id="editStreetAddress" name="streetAddress" required>
            </div>
          </div>

          <div class="row g-3 mt-2">
            <div class="col-md-6">
              <label for="editCity" class="form-label">City</label>
              <input type="text" class="form-control" id="editCity" name="city" required>
            </div>
            <div class="col-md-3">
              <label for="editState" class="form-label">State</label>
              <input type="text" class="form-control" id="editState" name="state" required>
            </div>
            <div class="col-md-3">
              <label for="editPincode" class="form-label">Pincode</label>
              <input type="text" class="form-control" id="editPincode" name="pincode" required>
            </div>
          </div>

          <div class="row g-3 mt-2">
            <div class="col-md-6">
              <label for="editCountry" class="form-label">Country</label>
              <select class="form-select" id="editCountry" name="country" required>
                <option value="India">India</option>
                <option value="US">United States</option>
                <option value="CA">Canada</option>
                <option value="UK">United Kingdom</option>
              </select>
            </div>
            <div class="col-md-6">
              <label for="editPhone" class="form-label">Phone Number</label>
              <input type="tel" class="form-control" id="editPhone" name="phone" required>
            </div>
          </div>

          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="editDefaultAddress" name="defaultAddress">
            <label class="form-check-label" for="editDefaultAddress">Set as default address</label>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="updateAddressBtn">Update Address</button>
      </div>
    </div>
  </div>
</div>

<%- include('../../views/partials/user/footer')%>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  const Toast = Swal.mixin({
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true,
    didOpen: (toast) => {
      toast.addEventListener('mouseenter', Swal.stopTimer)
      toast.addEventListener('mouseleave', Swal.resumeTimer)
    }
  });
</script>

<!-- Razorpay Checkout Script -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>

/* --------- Checkout page client script (replace your old script) --------- */

/* Utils: build address HTML (same as before) */
function formatAddressHTML(addr) {
  return `
    <div class="address-item border rounded p-3 mb-3 bg-light"
         id="addr-${addr._id}"
         data-id="${addr._id}"
         data-address-type="${addr.addressType || ''}"
         data-full-name="${addr.fullName || ''}"
         data-street-address="${addr.streetAddress || ''}"
         data-city="${addr.city || ''}"
         data-state="${addr.state || ''}"
         data-pincode="${addr.pincode || ''}"
         data-country="${addr.country || ''}"
         data-phone="${addr.phone || ''}"
         data-default="${addr.defaultAddress ? true : false}">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <label style="cursor:pointer">
            <input type="radio" name="selectedAddress" class="me-2 address-radio" value="${addr._id}" ${addr.defaultAddress ? 'checked' : ''} />
            <strong>${(addr.addressType && addr.addressType.charAt(0).toUpperCase() + addr.addressType.slice(1)) || 'Address'}</strong>
          </label>

          <p class="mb-0 mt-2">
            <strong>${addr.fullName}</strong><br>
            ${addr.streetAddress}<br>
            ${addr.city}, ${addr.state} - ${addr.pincode}<br>
            ${addr.country}<br>
            Phone: ${addr.phone}
          </p>
        </div>

        <div class="mt-2 text-end">
          <button class="btn btn-sm btn-outline-primary mb-1" onclick="openEditAddress('${addr._id}')">Edit</button>
          <button class="btn btn-sm btn-outline-danger" onclick="deleteAddress('${addr._1d || addr._id}')">Remove</button>
        </div>
      </div>
    </div>
  `;
}

/* Render address list */
function updateAddressList(addresses) {
  const list = document.getElementById('addressList');
  const addButtonHTML = `<div class="d-grid mt-2"><button class="btn btn-outline-primary" id="addAddressBtn"><i class="fas fa-plus me-2"></i> Add New Address</button></div>`;
  let html = '';
  if (!addresses || addresses.length === 0) {
    html = `<p class="text-muted">No addresses found. Please add one.</p>`;
  } else {
    addresses.forEach(addr => {
      if (addr.isActive === false) return;
      html += formatAddressHTML(addr);
    });
  }
  html += addButtonHTML;
  if (list) list.innerHTML = html;
}

/* Open Add Address modal (safe) */
function openAddAddress() {
  const form = document.getElementById('addressForm');
  if (form) form.reset();
  const lbl = document.getElementById('addressModalLabel');
  if (lbl) lbl.textContent = 'Add New Address';
  const def = document.getElementById('defaultAddress');
  if (def) def.checked = false;
  const modalEl = document.getElementById('addressModal');
  if (modalEl) {
    const modal = new bootstrap.Modal(modalEl);
    modal.show();
  } else {
    console.warn('addressModal element not found');
  }
}

/* Save New Address */
async function saveAddress() {
  try {
    const form = document.getElementById('addressForm');
    if (!form) return alert('Address form not found');
    const fd = new FormData(form);
    const payload = Object.fromEntries(fd.entries());
    payload.defaultAddress = !!fd.get('defaultAddress');

    // basic validation
    const required = ['fullName','streetAddress','city','state','pincode','country','phone'];
    for (const k of required) {
      if (!payload[k] || payload[k].toString().trim() === '') {
        return alert('Please fill required field: ' + k);
      }
    }

    const res = await fetch('/addresses', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (res.ok && data.success) {
      // close modal and update list
      const modal = bootstrap.Modal.getInstance(document.getElementById('addressModal'));
      if (modal) modal.hide();
      updateAddressList(data.addresses.filter(a => a.isActive));
      Toast.fire({
          icon: 'success',
          title: 'Address added successfully'
      });
    } else {
      Toast.fire({
          icon: 'error',
          title: data.message || 'Failed to save address'
      });
    }
  } catch (err) {
    console.error('saveAddress error', err);
    Toast.fire({
        icon: 'error',
        title: 'Error saving address'
    });
  }
}

/* Open Edit modal (uses DOM card data attributes) - kept global for inline onclick */
function openEditAddress(addressId) {
  const card = document.getElementById('addr-' + addressId);
  if (!card) {
    alert('Address not found on page');
    return;
  }
  document.getElementById('editAddressId').value = addressId;
  document.getElementById('editAddressType').value = card.dataset.addressType || 'home';
  document.getElementById('editFullName').value = card.dataset.fullName || '';
  document.getElementById('editStreetAddress').value = card.dataset.streetAddress || '';
  document.getElementById('editCity').value = card.dataset.city || '';
  document.getElementById('editState').value = card.dataset.state || '';
  document.getElementById('editPincode').value = card.dataset.pincode || '';
  document.getElementById('editCountry').value = card.dataset.country || 'India';
  document.getElementById('editPhone').value = card.dataset.phone || '';
  document.getElementById('editDefaultAddress').checked = (card.dataset.default === 'true' || card.dataset.default === true);
  const modal = new bootstrap.Modal(document.getElementById('editAddressModal'));
  modal.show();
}

/* Update existing address */
async function updateAddress() {
  try {
    const id = document.getElementById('editAddressId').value;
    if (!id) return alert('Address id missing');
    const payload = {
      addressType: document.getElementById('editAddressType').value,
      fullName: document.getElementById('editFullName').value,
      streetAddress: document.getElementById('editStreetAddress').value,
      city: document.getElementById('editCity').value,
      state: document.getElementById('editState').value,
      pincode: document.getElementById('editPincode').value,
      country: document.getElementById('editCountry').value,
      phone: document.getElementById('editPhone').value,
      defaultAddress: document.getElementById('editDefaultAddress').checked
    };

    const res = await fetch('/addresses/' + id, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (res.ok && data.success) {
      const modal = bootstrap.Modal.getInstance(document.getElementById('editAddressModal'));
      if (modal) modal.hide();
      updateAddressList(data.addresses.filter(a => a.isActive));
      Toast.fire({
          icon: 'success',
          title: 'Address updated successfully'
      });
    } else {
      Toast.fire({
          icon: 'error',
          title: data.message || 'Failed to update address'
      });
    }
  } catch (err) {
    console.error('updateAddress error', err);
    Toast.fire({
        icon: 'error',
        title: 'Error updating address'
    });
  }
}

/* Soft delete (keeps inline Remove working as well) */
async function deleteAddress(addressId) {
  if (!confirm('Remove this address?')) return;
  try {
    const res = await fetch('/addresses/' + addressId + '/soft-delete', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
    });
    const data = await res.json();
    if (res.ok && data.success) {
      updateAddressList(data.addresses.filter(a => a.isActive));
      Toast.fire({
          icon: 'success',
          title: 'Address removed successfully'
      });
    } else {
      Toast.fire({
          icon: 'error',
          title: data.message || 'Delete failed'
      });
    }
  } catch (err) {
    console.error('deleteAddress error', err);
    Toast.fire({
        icon: 'error',
        title: 'Error deleting address'
    });
  }
}

/* Select payment method and update UI */
function selectPaymentMethod(method) {
  // Update radio button
  const radios = document.querySelectorAll('input[name="paymentMethod"]');
  radios.forEach(radio => {
    radio.checked = (radio.value === method);
  });

  // Update button text
  const btn = document.getElementById('placeOrderBtn');
  if (btn) {
    if (method === 'razorpay') {
      btn.innerHTML = '<i class="fas fa-credit-card me-2"></i>Proceed to Payment';
      btn.className = 'btn btn-primary w-100 mt-3';
    } else {
      btn.innerHTML = '<i class="fas fa-shopping-bag me-2"></i>Place Order (Cash on Delivery)';
      btn.className = 'btn btn-success w-100 mt-3';
    }
  }

  // Update payment option styling
  document.querySelectorAll('.payment-option').forEach(option => {
    option.style.backgroundColor = '';
    option.style.borderColor = '#dee2e6';
  });
  event.target.closest('.payment-option').style.backgroundColor = '#f8f9fa';
  event.target.closest('.payment-option').style.borderColor = '#0d6efd';
}

/* Place order (handles both COD and Razorpay) */
async function placeOrder() {
  try {
    const selected = document.querySelector('input[name="selectedAddress"]:checked');
    if (!selected) {
      return Toast.fire({
        icon: 'warning',
        title: 'Please select a delivery address'
      });
    }

    const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked');
    if (!paymentMethod) {
      return Toast.fire({
        icon: 'warning',
        title: 'Please select a payment method'
      });
    }

    const addressId = selected.value;
    const method = paymentMethod.value;

    if (method === 'razorpay') {
      // Initiate Razorpay payment
      await initRazorpayPayment(addressId);
    } else {
      // COD - place order directly
      const res = await fetch('/place-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ addressId, paymentMethod: 'COD' })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        window.location.href = '/orderSuccess/' + data.orderId;
      } else {
        Toast.fire({
          icon: 'error',
          title: data.message || 'Failed to place order'
        });
      }
    }
  } catch (err) {
    console.error('placeOrder error', err);
    Toast.fire({
      icon: 'error',
      title: 'Could not place order right now'
    });
  }
}

/* Initialize Razorpay Payment */
async function initRazorpayPayment(addressId) {
  try {
    // Create order on backend
    const res = await fetch('/create-razorpay-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ addressId })
    });
    const data = await res.json();

    if (!res.ok || !data.success) {
      return Toast.fire({
        icon: 'error',
        title: data.message || 'Failed to create payment order'
      });
    }

    // Razorpay options
    const options = {
      key: data.razorpayKeyId, // Razorpay key from backend
      amount: data.amount, // Amount in paise
      currency: data.currency || 'INR',
      name: 'Your Store Name',
      description: 'Order Payment',
      order_id: data.razorpayOrderId,
      handler: async function (response) {
        // Payment successful - verify on backend
        await verifyRazorpayPayment(response, addressId, data.orderId);
      },
      prefill: {
        name: data.customerName || '',
        email: data.customerEmail || '',
        contact: data.customerPhone || ''
      },
      theme: {
        color: '#0d6efd'
      },
      modal: {
        ondismiss: function() {
          window.location.href = '/orderFailure/' + data.orderId;
        }
      }
    };

    const razorpay = new Razorpay(options);
    razorpay.open();
  } catch (err) {
    console.error('Razorpay init error', err);
    Toast.fire({
      icon: 'error',
      title: 'Could not initialize payment'
    });
  }
}

/* Verify Razorpay Payment */
async function verifyRazorpayPayment(paymentResponse, addressId, orderId) {
  try {
    const res = await fetch('/verify-razorpay-payment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        razorpay_order_id: paymentResponse.razorpay_order_id,
        razorpay_payment_id: paymentResponse.razorpay_payment_id,
        razorpay_signature: paymentResponse.razorpay_signature,
        orderId: orderId,
        addressId: addressId
      })
    });
    const data = await res.json();

    if (res.ok && data.success) {
      Toast.fire({
        icon: 'success',
        title: 'Payment successful!'
      });
      setTimeout(() => {
        window.location.href = '/orderSuccess/' + data.orderId;
      }, 1000);
    } else {
      console.error('Payment verification failed:', data.message);
      // Redirect to failure page
      window.location.href = '/orderFailure/' + orderId;
    }
  } catch (err) {
    console.error('Payment verification error', err);
    // Redirect to failure page
    window.location.href = '/orderFailure/' + orderId;
  }
}

/* ---------- Attach listeners AFTER DOM loaded (safe) ---------- */
document.addEventListener('DOMContentLoaded', () => {
  try {
    // Add button might be rendered dynamically, so attach handler via delegation as fallback too
    const addBtn = document.getElementById('addAddressBtn');
    if (addBtn) {
      addBtn.addEventListener('click', openAddAddress);
      console.log('Add button handler attached');
    } else {
      // delegate: listen for clicks on document and open if target matches id
      document.addEventListener('click', (ev) => {
        if (ev.target && (ev.target.id === 'addAddressBtn' || ev.target.closest && ev.target.closest('#addAddressBtn'))) {
          openAddAddress();
        }
      });
      console.log('Add button delegated');
    }

    const saveBtn = document.getElementById('saveAddressBtn');
    if (saveBtn) {
      saveBtn.addEventListener('click', saveAddress);
      console.log('Save address handler attached');
    }

    const updateBtn = document.getElementById('updateAddressBtn');
    if (updateBtn) {
      updateBtn.addEventListener('click', updateAddress);
      console.log('Update address handler attached');
    }

    const placeBtn = document.getElementById('placeOrderBtn');
    if (placeBtn) {
      placeBtn.addEventListener('click', placeOrder);
      console.log('Place order handler attached');
    }

  } catch (err) {
    console.error('Listener attach error', err);
  }
});
</script>
