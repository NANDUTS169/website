<%- include('../../views/partials/user/header')%>

<div class="container my-4">
  <div class="row">

    <!-- LEFT: Addresses -->
    <div class="col-lg-7 mb-3">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>Select Delivery Address</h5>
        </div>
        <div class="card-body">
          <div id="addressList">
            <% if (!addresses || addresses.length === 0) { %>
              <p class="text-muted">No addresses found. Please add one.</p>
            <% } else { %>
              <% addresses.forEach(function(addr) { %>
                <div class="address-item border rounded p-3 mb-3 bg-light"
                     id="addr-<%= addr._id %>"
                     data-id="<%= addr._id %>"
                     data-address-type="<%= addr.addressType %>"
                     data-full-name="<%= addr.fullName %>"
                     data-street-address="<%= addr.streetAddress %>"
                     data-city="<%= addr.city %>"
                     data-state="<%= addr.state %>"
                     data-pincode="<%= addr.pincode %>"
                     data-country="<%= addr.country %>"
                     data-phone="<%= addr.phone %>"
                     data-default="<%= addr.defaultAddress ? true : false %>">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <label style="cursor:pointer">
                        <input type="radio" name="selectedAddress" class="me-2 address-radio" value="<%= addr._id %>" <%= addr.defaultAddress ? 'checked' : '' %> />
                        <strong><%= (addr.addressType && addr.addressType.charAt(0).toUpperCase() + addr.addressType.slice(1)) || 'Address' %></strong>
                      </label>

                      <p class="mb-0 mt-2">
                        <strong><%= addr.fullName %></strong><br>
                        <%= addr.streetAddress %><br>
                        <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %><br>
                        <%= addr.country %><br>
                        Phone: <%= addr.phone %>
                      </p>
                    </div>

                    <div class="mt-2 text-end">
                      <button class="btn btn-sm btn-outline-primary mb-1" onclick="openEditAddress('<%= addr._id %>')">Edit</button>
                      <button class="btn btn-sm btn-outline-danger" onclick="deleteAddress('<%= addr._id %>')">Remove</button>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } %>

            <div class="d-grid mt-2">
              <button class="btn btn-outline-primary" id="addAddressBtn"><i class="fas fa-plus me-2"></i> Add New Address</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Order Summary -->
    <div class="col-lg-5">
      <div class="card mb-3">
        <div class="card-body">
          <h4 class="mb-3">Order Summary</h4>

          <% if (!cartItems || cartItems.length === 0) { %>
            <p class="text-muted">Your cart is empty.</p>
          <% } else { %>
            <% cartItems.forEach(function(item) { %>
              <div class="d-flex align-items-center mb-3">
                <img src="/uploads/product-images/<%= (item.product.productImage && item.product.productImage[0]) ? item.product.productImage[0] : 'placeholder.png' %>"
                     style="width:60px;height:60px;object-fit:cover;border-radius:4px; margin: 1rem;">
                <div class="ms-2">
                  <strong><%= item.product.productName || item.product.name || 'Product' %></strong><br>
                  Qty: <%= item.quantity %> &nbsp; | &nbsp;
                  ₹ <%= item.unitPrice %> each <br>
                  <small class="text-muted">Item total: ₹ <%= item.itemTotal %></small>
                </div>
              </div>
            <% }) %>
          <% } %>

          <hr>

          <div class="d-flex justify-content-between"><span>Subtotal:</span> <span>₹ <%= subTotal %></span></div>
          <div class="d-flex justify-content-between"><span>Discount:</span> <span>₹ <%= discount %></span></div>
          <div class="d-flex justify-content-between"><span>Taxes:</span> <span>₹ <%= taxes %></span></div>
          <div class="d-flex justify-content-between"><span>Shipping:</span> <span>₹ <%= shipping %></span></div>

          <hr>

          <div class="d-flex justify-content-between fw-bold"><span>Total:</span> <span>₹ <%= total %></span></div>

          <hr>

          <!-- Payment Method Selection -->
          <div class="payment-method-section mt-3">
            <h6 class="mb-3"><i class="fas fa-credit-card me-2"></i>Select Payment Method</h6>
            
            <div class="payment-option border rounded p-3 mb-2" style="cursor: pointer; transition: all 0.3s;" onclick="selectPaymentMethod('razorpay')">
              <label style="cursor: pointer; width: 100%;">
                <input type="radio" name="paymentMethod" value="razorpay" class="me-2">
                <strong>Razorpay (Online Payment)</strong>
                <p class="mb-0 mt-1 text-muted small">Pay securely using Credit/Debit Card, UPI, Net Banking, or Wallet</p>
              </label>
            </div>

            <div class="payment-option border rounded p-3 mb-2" style="cursor: pointer; transition: all 0.3s;" onclick="selectPaymentMethod('cod')">
              <label style="cursor: pointer; width: 100%;">
                <input type="radio" name="paymentMethod" value="cod" class="me-2" checked>
                <strong>Cash on Delivery (COD)</strong>
                <p class="mb-0 mt-1 text-muted small">Pay with cash when your order is delivered</p>
              </label>
            </div>
          </div>

          <button id="placeOrderBtn" class="btn btn-success w-100 mt-3">
            <i class="fas fa-shopping-bag me-2"></i>Place Order (Cash on Delivery)
          </button>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Address Modal -->
<div class="modal fade" id="addressModal" tabindex="-1" aria-labelledby="addressModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addressModalLabel">Add New Address</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="addressForm">
          <div class="row g-3">
            <div class="col-md-6">
              <label for="addressType" class="form-label">Address Type</label>
              <select class="form-select" id="addressType" name="addressType" required>
                <option value="home">Home Address</option>
                <option value="work">Work Address</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="col-md-6">
              <label for="fullName" class="form-label">Full Name</label>
              <input type="text" class="form-control" id="fullName" name="fullName" placeholder="Enter full name" required>
            </div>
          </div>

          <div class="row g-3 mt-2">
            <div class="col-12">
              <label for="streetAddress" class="form-label">Street Address</label>
              <input type="text" class="form-control" id="streetAddress" name="streetAddress" placeholder="Enter street address" required>
            </div>
          </div>

          <div class="row g-3 mt-2">
            <div class="col-md-6">
              <label for="city" class="form-label">City</label>
              <input type="text" class="form-control" id="city" name="city" placeholder="Enter city" required>
            </div>
            <div class="col-md-3">
              <label for="state" class="form-label">State</label>
              <input type="text" class="form-control" id="state" name="state" placeholder="State" required>
            </div>
            <div class="col-md-3">
              <label for="pincode" class="form-label">Pincode</label>
              <input type="text" class="form-control" id="pincode" name="pincode" placeholder="pincode" required>
            </div>
          </div>

          <div class="row g-3 mt-2">
            <div class="col-md-6">
              <label for="country" class="form-label">Country</label>
              <select class="form-select" id="country" name="country" required>
                <option value="India">India</option>
                <option value="US">United States</option>
                <option value="CA">Canada</option>
                <option value="UK">United Kingdom</option>
              </select>
            </div>
            <div class="col-md-6">
              <label for="phone" class="form-label">Phone Number</label>
              <input type="tel" class="form-control" id="phone" name="phone" placeholder="Enter phone number" required>
            </div>
          </div>

          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="defaultAddress" name="defaultAddress">
            <label class="form-check-label" for="defaultAddress">Set as default address</label>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveAddressBtn">Save Address</button>
      </div>
    </div>
  </div>
</div>

<!-- Edit Address Modal -->
