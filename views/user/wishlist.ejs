<%- include("../../views/partials/user/header") %>

<div class="breadcrumbs">
  <div class="container">
    <div class="row">
      <div class="col">
        <p class="bread"><span><a href="/">Home</a></span> / <span>My Wishlist</span></p>
      </div>
    </div>
  </div>
</div>

<div class="colorlib-product">
  <div class="container">
    <div class="row row-pb-lg">
      <div class="col-md-12">
        <div class="product-name d-flex">
          <div class="one-forth text-left px-4"><span>Product</span></div>
          <div class="one-eight text-center"><span>Price</span></div>
          <div class="one-eight text-center"><span>Status</span></div>
          <div class="one-eight text-center"><span>Add to Cart</span></div>
          <div class="one-eight text-center px-4"><span>Remove</span></div>
        </div>

        <% if (wishlist && wishlist.items.length > 0) { %>
          <% wishlist.items.forEach(item => { %>
          <div class="product-cart d-flex wishlist-item" id="wishlist-<%= item.productId._id %>">
            <div class="one-forth">
              <div class="product-img" style="background-image: url('/uploads/product-images/<%= item.productId.productImage[0] %>');"></div>
              <div class="display-tc">
                <h3><%= item.productId.productName %></h3>
              </div>
            </div>

            <div class="one-eight text-center">
              <div class="display-tc">
                <span class="price">₹<%= item.productId.salePrice.toFixed(2) %></span>
              </div>
            </div>

            <div class="one-eight text-center">
              <div class="display-tc">
                <% if (item.productId.isBlocked || (item.productId.category && !item.productId.category.isListed)) { %>
                  <span class="text-danger">Unavailable</span>
                <% } else if (item.productId.quantity <= 0) { %>
                  <span class="text-danger">Out of Stock</span>
                <% } else { %>
                  <span class="text-success">In Stock</span>
                <% } %>
              </div>
            </div>

            <div class="one-eight text-center">
              <div class="display-tc">
                <% if (item.productId.quantity > 0 && !item.productId.isBlocked && (item.productId.category && item.productId.category.isListed)) { %>
                  <% if (item.productId.variants && item.productId.variants.length > 0) { %>
                    <a href="/productdetails/<%= item.productId._id %>?error=select_size" class="btn btn-sm btn-primary d-inline-flex align-items-center">
                      <i class="icon-shopping-cart me-1" style="font-size: inherit;"></i> Add to Cart
                    </a>
                  <% } else { %>
                    <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center" onclick="moveToCart('<%= item.productId._id %>')">
                      <i class="icon-shopping-cart me-1" style="font-size: inherit;"></i> Add to Cart
                    </button>
                  <% } %>
                <% } else { %>
                  <button class="btn btn-sm btn-secondary d-inline-flex align-items-center" disabled>
                    <i class="icon-shopping-cart me-1" style="font-size: inherit;"></i> Add to Cart
                  </button>
                <% } %>
              </div>
            </div>

            <div class="one-eight text-center">
              <div class="display-tc">
                <button class="wishlist-btn" onclick="removeFromWishlist(this, '<%= item.productId._id %>')">
                  <i class="icon-heart" style="font-size:20px; color:red;"></i>
                </button>
              </div>
            </div>

          </div>
          <% }) %>
        <% } else { %>
          <div class="text-center">
            <h4>Your wishlist is empty.</h4>
          </div>
        <% } %>

      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  const Toast = Swal.mixin({
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true
  });

  async function moveToCart(productId) {
    try {
      const response = await fetch("/addToCart", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ productId, quantity: 1 })
      });

      const result = await response.json();

      if (response.ok) {
        Toast.fire({ icon: 'success', title: 'Added to cart!' });
      } else {
        Toast.fire({ icon: 'error', title: result.message || 'Failed to add to cart' });
      }
    } catch (error) {
      console.error("Error adding to cart:", error);
      Toast.fire({ icon: 'error', title: 'An error occurred' });
    }
  }

  async function removeFromWishlist(btn, productId) {
    try {
      btn.disabled = true;
      const res = await fetch("/wishlist/remove", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ productId })
      }); 

      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        Toast.fire({ icon: "error", title: data.message || "Failed to remove." });
        btn.disabled = false;
        return;
      }
      
      Toast.fire({ icon: "success", title: "Removed from Wishlist" });

      const wishlistItem = document.getElementById(`wishlist-${productId}`);
      if (wishlistItem) wishlistItem.remove();

      if (document.querySelectorAll('.wishlist-item').length === 0) {
        setTimeout(() => location.reload(), 1500);
      }

    } catch (err) {
      console.error(err);
      Toast.fire({ icon: "error", title: "Something went wrong." });
      btn.disabled = false;
    }
  }
</script>

<%- include("../../views/partials/user/footer") %>
