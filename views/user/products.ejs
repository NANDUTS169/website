<%- include("../../views/partials/user/header") %>
<style>
    html,
    body {
        overflow-x: hidden !important;
    }

    .row {
        margin-left: 0;
        margin-right: 0;
    }

    .container-fluid,
    .container {
        padding-left: 15px;
        padding-right: 15px;
    }

    .product-entry {
        position: relative;
        transition: transform 0.2s ease;
    }

    .product-entry:hover {
        transform: scale(1.03);
    }

    .prod-img img {
        max-height: 300px;
        object-fit: cover;
        width: 100%;
    }

    .wishlist-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 100;
        background: transparent;
        border: 0;
    }
</style>


<div class="colorlib-product">
    <div class="container">

        <!-- Heading -->
        <div class="row">
            <div class="col-sm-8 offset-sm-2 text-center colorlib-heading">
                <h2>All Products</h2>
            </div>
        </div>

        <!-- Filters -->
        <div class="row mb-4">
            <!-- Search -->
            <div class="col-md-3">
                <input type="text" id="searchInput" class="form-control"
                    placeholder="Search...">
            </div>

            <!-- Category Filter -->
            <div class="col-md-3">
                <select id="categoryFilter" class="form-control">
                    <option value="">All Categories</option>
                    <option value="Men">Men</option>
                    <option value="Women">Women</option>
                </select>
            </div>

            <!-- Price Filter -->
            <div class="col-md-3 d-flex">
                <input type="number" id="minPrice" class="form-control"
                    placeholder="Min">
                <input type="number" id="maxPrice" class="form-control ms-2"
                    placeholder="Max">
                <button class="btn btn-secondary ms-2"
                    onclick="applyFilters()">Go</button>
            </div>

            <!-- Sorting -->
            <div class="col-md-3">
                <select id="sortSelect" class="form-control">
                    <option value="">Sort By</option>
                    <option value="price_asc">Price: Low to High</option>
                    <option value="price_desc">Price: High to Low</option>
                    <option value="newest">Newest</option>
                </select>
            </div>
        </div>

        <!-- Product List -->
        <div class="row" id="productList">
            <% if (products && products.length > 0) { %>
            <% products.forEach(product => {
                const unavailable = (product.isBlocked === true) || (product.status !== "Available") || (product.quantity <= 0); 
            %>
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4 text-center d-flex">
                <div class="product-entry border position-relative w-100">

                    <!-- Product Image -->
                    <a href="/productdetails/<%= product._id %>"
                        class="prod-img d-block">
                        <% if (product.productImage && product.productImage.length > 0) { %>
                        <img src="/uploads/product-images/<%= product.productImage[0] %>"
                            class="img-fluid"
                            alt="<%= product.productName %>">
                        <% } else { %>
                        <img src="/images/product-placeholder.jpg"
                            class="img-fluid"
                            alt="<%= product.productName %>">
                        <% } %>
                    </a>

                    <!-- Wishlist -->
                    <button class="wishlist-btn" title="Add to wishlist"
                        onclick="addToWishlist(this, '<%= product._id %>')">
                        <i class="icon-heart-outline"
                            style="font-size: 20px; color: grey;"></i>
                    </button>


                    <!-- Info -->
                    <div class="desc">
                        <h2><a
                                href="/productdetails/<%= product._id %>">
                                <%= product.productName %>
                            </a></h2>
                        <span class="price">₹
                            <%= product.salePrice %>
                        </span>
                        <% if (unavailable) { %>
                        <p><button class="btn btn-sm btn-secondary mt-2"
                                disabled>Unavailable</button></p>
                        <% } else { %>
                        <p><button class="btn btn-sm btn-primary mt-2"
                                onclick="addToCart('<%= product._id %>')">Add
                                to Cart</button></p>
                        
                        <% } %>
                    </div>
                </div>
            </div>
            <% }) %>
            <% } else { %>
            <div class="col-md-12 text-center">
                <p>No products available right now.</p>
            </div>
            
            <% } %>
        </div>

        <!-- Pagination -->
        <% if (pagination && pagination.totalPages > 1) { 
            const curr = Number(pagination.currentPage);
            const total = Number(pagination.totalPages);
            const prev = curr - 1;
            const next = curr + 1;
            const max = 5;
            
            let start = Math.max(1, curr - Math.floor(max / 2));
            let end = Math.min(total, start + max - 1);
            
            if (end - start < max - 1) {
                start = Math.max(1, end - max + 1);
            }
        %>
        <div class="row">
            <div class="col-md-12 text-center">
                <ul class="pagination justify-content-center">
                    <!-- Previous Button -->
                    <li class="page-item <%= !pagination.hasPrevPage ? 'disabled' : '' %>">
                        <a class="page-link" href="#" 
                           onclick="changePage('<%= prev %>'); return false;">
                            Prev
                        </a>
                    </li>
                    
                    <!-- First page if not in range -->
                    <% if (start > 1) { %>
                        <li class="page-item">
                            <a class="page-link" href="#" onclick="changePage(1); return false;">1</a>
                        </li>
                        <% if (start > 2) { %>
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        <% } %>
                    <% } %>
                    
                    <!-- Page number buttons -->
                    <% for (let i = start; i <= end; i++) { %>
                        <li class="page-item <%= i === curr ? 'active' : '' %>">
                            <a class="page-link" href="#" 
                               onclick="changePage('<%= i %>'); return false;">
                                <%= i %>
                            </a>
                        </li>
                    <% } %>
                    
                    <!-- Last page if not in range -->
                    <% if (end < total) { %>
                        <% if (end < total - 1) { %>
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        <% } %>
                        <li class="page-item">
                            <a class="page-link" href="#" onclick="changePage('<%= total %>'); return false;">
                                <%= total %>
                            </a>
                        </li>
                    <% } %>
                    
                    <!-- Next Button -->
                    <li class="page-item <%= !pagination.hasNextPage ? 'disabled' : '' %>">
                        <a class="page-link" href="#" 
                           onclick="changePage('<%= next %>'); return false;">
                            Next
                        </a>
                    </li>
                </ul>
                <p class="text-muted">
                    Showing page <%= curr %> of <%= total %> 
                    (<%= pagination.totalProducts %> total products)
                </p>
            </div>
        </div>
        <% } %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    async function addToCart(productId) {
        try {
            const res = await fetch("/addToCart", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    productId,
                    quantity: 1
                })
            });

            const data = await res.json().catch(() => ({}));

            if (res.status === 401) {
                window.location = "/login?next=" + encodeURIComponent(window
                    .location.pathname + window.location.search);
                return;
            }

            if (!res.ok) {
                Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: data.message || "Failed to add to cart.",
                    confirmButtonColor: "#d33"
                });
                return;
            }

            Swal.fire({
                icon: "success",
                title: "Added to Cart!",
                text: data.message ||
                    "Product added to cart successfully.",
                showConfirmButton: false,
                timer: 1500
            });
        } catch (err) {
            console.error(err);
            Swal.fire({
                icon: "error",
                title: "Error",
                text: "Something went wrong. Please try again later.",
                confirmButtonColor: "#d33"
            });
        }
    }


    // Add to wishlist
    async function addToWishlist(btn, productId) {
        try {
            // Optional: disable button while processing
            btn.disabled = true;

            const res = await fetch("/wishlist/add", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    productId
                })
            });

            const data = await res.json().catch(() => ({}));

            if (res.status === 401) {
                window.location = "/login?next=" + encodeURIComponent(window
                    .location.pathname + window.location.search);
                return;
            }

            if (!res.ok) {
                Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: data.message ||
                        "Failed to add to wishlist.",
                    confirmButtonColor: "#d33"
                });
                btn.disabled = false;
                return;
            }

            // Success: show swal
            Swal.fire({
                icon: "success",
                title: "Added to Wishlist!",
                text: data.message || "Product added successfully.",
                showConfirmButton: false,
                timer: 1500
            });

            // Change heart to filled red
            const icon = btn.querySelector('i');
            if (icon) {
                icon.classList.remove('icon-heart-outline'); // remove empty
                icon.classList.add('icon-heart'); // add filled
                icon.style.color = 'red'; // make it red
            }

            btn.disabled = false;
        } catch (err) {
            console.error(err);
            Swal.fire({
                icon: "error",
                title: "Error",
                text: "Something went wrong. Please try again later.",
                confirmButtonColor: "#d33"
            });
            btn.disabled = false;
        }
    }


    // Pagination
    let currentPage = parseInt('<%= (typeof pagination !== "undefined" && pagination && pagination.currentPage) ? pagination.currentPage : 1 %>') || 1;
    
    function changePage(page) {
        currentPage = Number(page);
        applyFilters(false); // Don't reset page when navigating
    }

    // Filters
    document.getElementById("searchInput").addEventListener("input",
        applyFilters);
    document.getElementById("categoryFilter").addEventListener("change",
        applyFilters);
    document.getElementById("sortSelect").addEventListener("change",
        applyFilters);

    async function applyFilters(resetPage = true) {
        if (resetPage) {
            currentPage = 1; // Reset to first page when filters change
        }
        
        const search = document.getElementById("searchInput").value;
        const category = document.getElementById("categoryFilter").value;
        const minPrice = document.getElementById("minPrice").value;
        const maxPrice = document.getElementById("maxPrice").value;
        const sort = document.getElementById("sortSelect").value;

        const query = new URLSearchParams({
            search,
            category,
            minPrice,
            maxPrice,
            sort,
            page: currentPage
        });
        
        // Helper to escape HTML to prevent XSS and broken layout
        const escapeHtml = (unsafe) => {
            return unsafe
                 .replace(/&/g, "&amp;")
                 .replace(/</g, "&lt;")
                 .replace(/>/g, "&gt;")
                 .replace(/"/g, "&quot;")
                 .replace(/'/g, "&#039;");
        }

        try {
            const res = await fetch(`/products?${query.toString()}`, {
                headers: {
                    "Accept": "application/json"
                }
            });
            const data = await res.json();

            const container = document.getElementById("productList");
            container.innerHTML = "";

            if (!data.products || data.products.length === 0) {
                container.innerHTML =
                    `<div class="col-12 text-center"><p>No products found.</p></div>`;
                // Hide pagination when no products
                updatePaginationUI(null);
                return;
            }

            data.products.forEach(p => {
                const unavailable = (p.isBlocked === true) || (p.status !== "Available") || (p.quantity <= 0);
                const safeName = escapeHtml(p.productName);
                const imageSrc = (p.productImage && p.productImage.length > 0) 
                    ? `/uploads/product-images/${p.productImage[0]}` 
                    : '/images/product-placeholder.jpg'; // Fallback image

                container.innerHTML += `
          <div class="col-lg-3 col-md-4 col-sm-6 mb-4 text-center d-flex">
            <div class="product-entry border position-relative w-100">
              <a href="/productdetails/${p._id}" class="prod-img d-block">
                <img src="${imageSrc}" class="img-fluid" alt="${safeName}">
              </a>
              <button class="wishlist-btn" onclick="addToWishlist(this, '${p._id}')">
                <i class="icon-heart-outline" style="font-size: 20px; color: grey;"></i>
              </button>
              <div class="desc">
                <h2><a href="/productdetails/${p._id}">${safeName}</a></h2>
                <span class="price">₹ ${p.salePrice}</span>
                ${unavailable 
                  ? `<p><button class="btn btn-sm btn-secondary mt-2" disabled>Unavailable</button></p>`
                  : `<p><button class="btn btn-sm btn-primary mt-2" onclick="addToCart('${p._id}')">Add to Cart</button></p>`}
              </div>
            </div>
          </div>
        `;
            });
            
            // Update pagination UI
            updatePaginationUI(data.pagination);
        } catch (err) {
            console.error("Filter error", err);
        }
    }
    
    function updatePaginationUI(pagination) {
        // Find or create pagination container
        let paginationContainer = document.querySelector('.pagination');
        let paginationRow = paginationContainer ? paginationContainer.closest('.row') : null;
        
        // If no pagination data or only 1 page, hide pagination
        if (!pagination || pagination.totalPages <= 1) {
            if (paginationRow) {
                paginationRow.style.display = 'none';
            }
            return;
        }
        
        // Show pagination row
        if (paginationRow) {
            paginationRow.style.display = '';
        }
        
        // Generate pagination HTML
        const maxPages = 5;
        const currentPage = pagination.currentPage;
        const totalPages = pagination.totalPages;
        
        let startPage = Math.max(1, currentPage - Math.floor(maxPages / 2));
        let endPage = Math.min(totalPages, startPage + maxPages - 1);
        
        if (endPage - startPage < maxPages - 1) {
            startPage = Math.max(1, endPage - maxPages + 1);
        }
        
        let html = '';
        
        // Previous button
        html += `<li class="page-item ${!pagination.hasPrevPage ? 'disabled' : ''}">
            <a class="page-link" href="#" onclick="changePage(${currentPage - 1}); return false;">Prev</a>
        </li>`;
        
        // First page if not in range
        if (startPage > 1) {
            html += `<li class="page-item">
                <a class="page-link" href="#" onclick="changePage(1); return false;">1</a>
            </li>`;
            if (startPage > 2) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }
        
        // Page numbers
        for (let i = startPage; i <= endPage; i++) {
            html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                <a class="page-link" href="#" onclick="changePage(${i}); return false;">${i}</a>
            </li>`;
        }
        
        // Last page if not in range
        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
            html += `<li class="page-item">
                <a class="page-link" href="#" onclick="changePage(${totalPages}); return false;">${totalPages}</a>
            </li>`;
        }
        
        // Next button
        html += `<li class="page-item ${!pagination.hasNextPage ? 'disabled' : ''}">
            <a class="page-link" href="#" onclick="changePage(${currentPage + 1}); return false;">Next</a>
        </li>`;
        
        // Update pagination
        if (paginationContainer) {
            paginationContainer.innerHTML = html;
            
            // Update info text
            const infoText = paginationRow.querySelector('.text-muted');
            if (infoText) {
                infoText.textContent = `Showing page ${currentPage} of ${totalPages} (${pagination.totalProducts} total products)`;
            } else {
                // Add info text if doesn't exist
                const col = paginationRow.querySelector('.col-md-12');
                if (col) {
                    col.innerHTML += `<p class="text-muted">Showing page ${currentPage} of ${totalPages} (${pagination.totalProducts} total products)</p>`;
                }
            }
        }
    }
</script>

<script>
document.addEventListener('DOMContentLoaded', async () => {
  try {
    // Request JSON from the same endpoint — server now returns { products, categories } when Accept: json
    const res = await fetch('/products', {
      headers: { 'Accept': 'application/json' }
    });
    if (!res.ok) throw new Error('Failed to load categories');

    const data = await res.json();
    const categories = data.categories || [];

    const sel = document.getElementById('categoryFilter');
    // keep the "All Categories" default and replace the rest
    sel.innerHTML = '<option value="">All Categories</option>';

    categories.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c._id;     // use id for exact matching (important)
      opt.textContent = c.name;
      sel.appendChild(opt);
    });

    // If you want the page to immediately show server-side results via AJAX (optional):
    // applyFilters();
  } catch (err) {
    console.error('Could not load categories:', err);
  }
});
</script>

<%- include("../../views/partials/user/footer") %>