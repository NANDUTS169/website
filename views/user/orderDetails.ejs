<%- include('../../views/partials/user/header') %>

<div class="container my-4">
  <% if (notFound) { %>
    <div class="alert alert-warning">Order <strong><%= orderId %></strong> not found.</div>
  <% } else if (forbidden) { %>
    <div class="alert alert-danger">You do not have permission to view this order.</div>
  <% } else { %>

  <div class="row">
    <div class="col-md-8">
      <div class="card mb-3">
        <div class="card-body">
          <h5>Order ID: <strong><%= order.orderId %></strong></h5>
          <p class="text-muted">Placed on: <%= order.displayDate %></p>
          <p>Status: 
            <% 
              let badgeClass = 'bg-info text-dark';
              if (order.status === 'Failed' || order.status === 'Cancelled') {
                badgeClass = 'bg-danger';
              } else if (order.status === 'Delivered') {
                badgeClass = 'bg-success';
              } else if (order.status === 'Processing') {
                badgeClass = 'bg-primary';
              } else if (order.status === 'Shipped') {
                badgeClass = 'bg-warning text-dark';
              }
            %>
            <span class="badge <%= badgeClass %>"><%= order.status %></span>
          </p>

          <hr>

          <h6>Items</h6>
          <% order.itemsForView.forEach(function(it){ %>
            <div class="d-flex align-items-center mb-3 p-2 border rounded">
              <img src="/uploads/product-images/<%= (it.product && it.product.productImage && it.product.productImage[0]) ? it.product.productImage[0] : 'placeholder.png' %>"
                   style="width:72px;height:72px;object-fit:cover;border-radius:4px;margin-right:1rem">
              <div class="flex-grow-1">
                <strong><%= it.name %></strong>
                <span class="badge bg-secondary ms-2"><%= it.status %></span>
                <br>
                Qty: <%= it.qty %> &nbsp; × &nbsp; ₹ <%= it.unit %><br>
                <small class="text-muted">Item total: ₹ <%= it.itemTotal %></small>
              </div>
              
              <div class="ms-3">
                <% if (['Pending', 'Processing'].includes(it.status)) { %>
                  <button class="btn btn-sm btn-outline-danger" onclick="cancelItem('<%= order.orderId %>', '<%= it._id %>')">Cancel</button>
                <% } else if (it.status === 'Delivered') { %>
                  <button class="btn btn-sm btn-outline-secondary" onclick="returnItem('<%= order.orderId %>', '<%= it._id %>')">Return</button>
                <% } %>
              </div>
            </div>
          <% }) %>

        </div>
      </div>

      <!-- Buttons: cancel if allowed -->
      <!-- Order Level Actions -->
      <div class="d-flex gap-2 mb-4">
        <% if (['Pending','Processing'].includes(order.status)) { %>
          <button class="btn btn-outline-danger flex-fill" onclick="cancelEntireOrder('<%= order.orderId %>')">Cancel Entire Order</button>
        <% } %>

        <% if (order.status === 'Delivered') { %>
          <button class="btn btn-outline-secondary flex-fill" onclick="returnOrder('<%= order.orderId %>')">Return Order</button>
        <% } %>
      </div>

      <!-- Retry payment button for failed orders -->
      <% if (order.status === 'Failed' && order.paymentMethod === 'Razorpay') { %>
        <div class="mb-4">
          <div class="alert alert-warning" role="alert">
            <strong>Payment Failed!</strong> Your order was created but the payment could not be processed.
          </div>
          <button class="btn btn-primary" id="retryPaymentBtn" onclick="retryPayment('<%= order.orderId %>')">Retry Payment</button>
        </div>
      <% } %>

      <!-- Shipping / address -->
      <div class="card">
        <div class="card-body">
          <h6>Shipping Address</h6>
          <p>
            <strong><%= order.shippingAddress.name %></strong><br>
            <%= order.shippingAddress.landmark || '' %><br>
            <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %><br>
            Phone: <%= order.shippingAddress.phone %>
          </p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card p-3">
        <h6>Order Summary</h6>
        <div class="d-flex justify-content-between">
          <span>Subtotal</span><span>₹ <%= order.totalPrice %></span>
        </div>
        <div class="d-flex justify-content-between">
          <span>Discount</span><span>₹ <%= order.discount %></span>
        </div>
        <div class="d-flex justify-content-between">
          <span>Taxes</span><span>₹ <%= (order.finalAmount - order.totalPrice + order.discount - (order.shipping || 0)) %></span>
        </div>
        <div class="d-flex justify-content-between">
          <span>Shipping</span><span>₹ <%= order.shipping || 0 %></span>
        </div>
        <hr>
        <div class="d-flex justify-content-between fw-bold">
          <span>Total</span><span>₹ <%= order.finalAmount %></span>
        </div>

        <div class="mt-3">
          <a href="/order/<%= order.orderId %>/invoice" class="btn btn-primary w-100 mb-2" id="downloadInvoiceBtn">Download Invoice</a>
          <a href="/products" class="btn btn-outline-secondary w-100">Continue Shopping</a>
        </div>
      </div>
    </div>
  </div>

  <% } %>
</div>

<!-- Scripts -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
const Toast = Swal.mixin({
  toast: true,
  position: 'top-end',
  showConfirmButton: false,
  timer: 3000,
  timerProgressBar: true
});

// Retry Payment Logic
async function retryPayment(orderId) {
  try {
    const btn = document.getElementById('retryPaymentBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...';

    const res = await fetch('/retry-razorpay-payment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ orderId: orderId })
    });

    const data = await res.json();

    if (!res.ok || !data.success) {
      btn.disabled = false;
      btn.innerText = 'Retry Payment';
      return Toast.fire({ icon: 'error', title: data.message || 'Could not initiate payment' });
    }

    const options = {
      key: data.razorpayKeyId,
      amount: data.amount,
      currency: data.currency,
      name: 'Footwear Store',
      description: 'Retry Order Payment',
      order_id: data.razorpayOrderId,
      handler: async function (response) {
        await verifyPayment(response, orderId);
      },
      prefill: {
        name: data.customerName,
        email: data.customerEmail,
        contact: data.customerPhone
      },
      theme: { color: '#0d6efd' },
      modal: {
        ondismiss: function() {
          btn.disabled = false;
          btn.innerText = 'Retry Payment';
          Toast.fire({ icon: 'info', title: 'Payment cancelled' });
        }
      }
    };

    const rzp = new Razorpay(options);
    rzp.open();

  } catch (err) {
    console.error('Retry error', err);
    const btn = document.getElementById('retryPaymentBtn');
    if (btn) {
      btn.disabled = false;
      btn.innerText = 'Retry Payment';
    }
    Toast.fire({ icon: 'error', title: 'Something went wrong' });
  }
}

async function verifyPayment(paymentResponse, orderId) {
  try {
    const res = await fetch('/verify-razorpay-payment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        razorpay_order_id: paymentResponse.razorpay_order_id,
        razorpay_payment_id: paymentResponse.razorpay_payment_id,
        razorpay_signature: paymentResponse.razorpay_signature,
        orderId: orderId
      })
    });
    const data = await res.json();

    if (data.success) {
      Toast.fire({ icon: 'success', title: 'Payment successful!' }).then(() => {
        window.location.href = '/orderSuccess/' + data.orderId;
      });
    } else {
      Toast.fire({ icon: 'error', title: data.message || 'Payment verification failed' });
    }
  } catch (err) {
    console.error(err);
    Toast.fire({ icon: 'error', title: 'Verification error' });
  }
}

// --- Order & Item Actions ---

// Cancel Specific Item
async function cancelItem(orderId, itemId) {
  const result = await Swal.fire({
    title: 'Cancel Item?',
    text: "Enter a reason (optional):",
    input: 'text',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    confirmButtonText: 'Yes, cancel it!'
  });

  if (result.isConfirmed) {
    try {
      const res = await fetch(`/order/${orderId}/item/${itemId}/cancel`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: result.value })
      });
      const data = await res.json();
      if (data.success) {
        Swal.fire('Cancelled!', 'Item has been cancelled.', 'success').then(() => location.reload());
      } else {
        Swal.fire('Error', data.message || 'Failed to cancel item', 'error');
      }
    } catch (err) {
      Swal.fire('Error', 'Server error', 'error');
    }
  }
}

// Return Specific Item
async function returnItem(orderId, itemId) {
  const result = await Swal.fire({
    title: 'Return Item?',
    text: "Please provide a reason for return (required):",
    input: 'text',
    inputValidator: (value) => {
      if (!value) return 'You need to write a reason!'
    },
    showCancelButton: true,
    confirmButtonText: 'Submit Return Request'
  });

  if (result.isConfirmed) {
    try {
      const res = await fetch(`/order/${orderId}/return`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: result.value, itemId: itemId })
      });
      const data = await res.json();
      if (data.success) {
        Swal.fire('Submitted!', 'Return request submitted.', 'success').then(() => location.reload());
      } else {
        Swal.fire('Error', data.message || 'Failed to submit return', 'error');
      }
    } catch (err) {
      Swal.fire('Error', 'Server error', 'error');
    }
  }
}

// Cancel Entire Order
async function cancelEntireOrder(orderId) {
  const result = await Swal.fire({
    title: 'Cancel Order?',
    text: "Enter a reason (optional):",
    input: 'text',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    confirmButtonText: 'Yes, cancel all!'
  });

  if (result.isConfirmed) {
    try {
      const res = await fetch(`/order/${orderId}/cancel-entire`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: result.value })
      });
      const data = await res.json();
      if (data.success) {
        Swal.fire('Cancelled!', 'Order has been cancelled.', 'success').then(() => location.reload());
      } else {
        Swal.fire('Error', data.message || 'Failed to cancel order', 'error');
      }
    } catch (err) {
      Swal.fire('Error', 'Server error', 'error');
    }
  }
}

// Return Entire Order
async function returnOrder(orderId) {
  const result = await Swal.fire({
    title: 'Return Order?',
    text: "Please provide a reason for return (required):",
    input: 'text',
    inputValidator: (value) => {
      if (!value) return 'You need to write a reason!'
    },
    showCancelButton: true,
    confirmButtonText: 'Submit Return Request'
  });

  if (result.isConfirmed) {
    try {
      const res = await fetch(`/order/${orderId}/return`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: result.value }) // no itemId implies entire order
      });
      const data = await res.json();
      if (data.success) {
        Swal.fire('Submitted!', 'Return request submitted.', 'success').then(() => location.reload());
      } else {
        Swal.fire('Error', data.message || 'Failed to submit return', 'error');
      }
    } catch (err) {
      Swal.fire('Error', 'Server error', 'error');
    }
  }
}
</script>

<%- include('../../views/partials/user/footer') %>
