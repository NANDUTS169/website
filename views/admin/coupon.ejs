<%- include("../../views/partials/admin/header") %>
<style>
  .col-md-3 {
    margin-bottom: 20px;
  }
</style>

<section class="content-main">
  <div class="content-header">
    <div>
      <h2 class="content-title card-title">Coupons</h2>
      <p>Add, edit or delete a coupon</p>
    </div>
    
    <header class="card-header text-center mb-20 bg-transparent border-0">
    <form action="" method="get" class="d-inline" onsubmit="updateCouponTable($('#couponSearchInput').val(), 1); return false;">
      <div class="input-group input-group-sm border border-1 border-grey rounded-pill shadow-sm" style="width: 500px; margin-left: auto; margin-right: 300px; background-color: white; padding: 3px;">
          <input type="text" class="form-control border-0 rounded-pill ms-2" placeholder="Search coupon name or code" name="search" id="couponSearchInput" autocomplete="off" value="<%= locals.search || '' %>" style="box-shadow: none;">
          <button class="btn border-0" type="button" onclick="clearCouponSearch()" id="clearCouponBtn" style="display: <%= locals.search ? 'inline-block' : 'none' %>;">
              <i class="material-icons md-close"></i>
          </button>
          <button class="btn btn-primary rounded-pill px-4 ms-2" type="submit">Search</button>
      </div>
    </form>
   </header>

    
  </div>
  
  <div class="card">
    <div class="card-body">
      <div class="row">
        <!-- Add Coupon Form -->
        <div class="col-md-3">
          <form onsubmit="return handleFormSubmit(event)">
            <div class="mb-4">
              <label for="coupon-name" class="form-label">Coupon Name</label>
              <input
                type="text"
                id="coupon-name"
                name="couponName"
                placeholder="Type here"
                class="form-control"
              />
              <div id="error-coupon-name" class="error-message"></div>
            </div>

            <div class="mb-4">
              <label for="start-date" class="form-label">Start Date</label>
              <input
                type="date"
                id="start-date"
                name="startDate"
                class="form-control"
              />
              <div id="error-start-date" class="error-message"></div>
            </div>

            <div class="mb-4">
              <label for="end-date" class="form-label">End Date</label>
              <input
                type="date"
                id="end-date"
                name="endDate"
                class="form-control"
              />
              <div id="error-end-date" class="error-message"></div>
            </div>

            <div class="mb-4">
              <label for="offer-price" class="form-label">Offer Percentage (%)</label>
              <input
                type="number"
                id="offer-price"
                name="offerPrice"
                placeholder="Type here"
                class="form-control"
              />
              <div id="error-offer-price" class="error-message"></div>
            </div>

            <div class="mb-4">
              <label for="minimum-price" class="form-label">Minimum Price</label>
              <input
                type="number"
                id="minimum-price"
                name="minimumPrice"
                placeholder="Type here"
                class="form-control"
              />
              <div id="error-minimum-price" class="error-message"></div>
            </div>

            <div class="d-grid">
              <button class="btn btn-primary" type="submit">
                Create Coupon
              </button>
            </div>
          </form>
        </div>

        <!-- Coupon List Table -->
        <div class="col-md-9" id="couponTableContainer">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Created On</th>
                  <th>Expire On</th>
                  <th>Offer Percentage</th>
                  <th>Minimum Price</th>
                  <th>Used Count</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% coupons.forEach(function(coupon) { %>
                <tr>
                  <td class="text-start"><%= coupon.name %></td>
                  <td class="text-start"><%= new Date(coupon.createdOn).toLocaleDateString('en-US') %></td>
                  <td class="text-start"><%= new Date(coupon.expireOn).toLocaleDateString('en-US') %></td>
                  <td class="text-start"><%= coupon.offerPrice %> %</td>
                  <td class="text-start"><%= coupon.minimumPrice %></td>
                  <td class="text-start"><%= coupon.userId.length %></td>
                  <td class="text-start"><%= coupon.isList ? 'Active' : 'Inactive' %></td>
                  <td class="text-start">
                    <a href="#" onclick="deleteCoupon('<%= coupon._id %>')" class="btn btn-sm btn-danger">Delete</a>
                    <a href="#" onclick="toggleStatus('<%= coupon._id %>')" class="btn btn-sm <%= coupon.isList ? 'btn-warning' : 'btn-success' %>">
                      <%= coupon.isList ? 'Deactivate' : 'Activate' %>
                    </a>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- pagination -->
          <div class="container mt-3">
              <nav aria-label="Page navigation">
                  <ul class="pagination justify-content-center mb-20">
                      <% for (let i = 1; i <= totalPages; i++) { %>
                      <li class="page-item <%=(i === currentPage) ? 'active' : '' %>">
                          <a class="page-link" href="?page=<%= i %>&search=<%= locals.search || '' %>" onclick="handlePagination(event, '<%= i %>')"><%= i %></a>
                      </li>
                      <% } %>
                  </ul>
              </nav>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  function validateForm() {
    document.querySelectorAll(".error-message").forEach((el) => (el.innerHTML = ""));
    const sDate = document.getElementsByName("startDate")[0].value;
    const eDate = document.getElementsByName("endDate")[0].value;
    const sDateObj = new Date(sDate);
    const eDateObj = new Date(eDate);
    const todayDateObj = new Date();
    todayDateObj.setHours(0, 0, 0, 0);

    if (sDateObj > eDateObj) {
      document.getElementById("error-end-date").innerHTML =
        "End date should be after the start date";
      return false;
    }

    if (sDateObj <= todayDateObj) {
     // document.getElementById("error-start-date").innerHTML =
       // "Start date should be greater than or equal to today's date";
    }

    const name = document.getElementsByName("couponName")[0].value;
    const offerPrice = document.getElementsByName("offerPrice")[0].value;
    const minimumPrice = document.getElementsByName("minimumPrice")[0].value;

    if (name === "") {
      document.getElementById("error-coupon-name").innerHTML =
        "Please enter coupon name";
      return false;
    }

    if (offerPrice === "") {
      document.getElementById("error-offer-price").innerHTML =
        "Please enter offer percentage";
      return false;
    }

    // Since we are doing percentage now, validate 0-100
    if (offerPrice > 100 || offerPrice < 1) {
       document.getElementById("error-offer-price").innerHTML =
        "Offer percentage must be between 1 and 100";
      return false; 
    }

    if (minimumPrice === "") {
      document.getElementById("error-minimum-price").innerHTML =
        "Please enter minimum price";
      return false;
    }

    if (isNaN(minimumPrice) || minimumPrice < 0) {
      document.getElementById("error-minimum-price").innerHTML =
        "Minimum price must be a positive number";
      return false;
    }

    return true;
  }

  function handleFormSubmit(event) {
    event.preventDefault();
    if (!validateForm()) return false;

    const name = document.getElementsByName("couponName")[0].value;
    const startDate = document.getElementsByName("startDate")[0].value;
    const endDate = document.getElementsByName("endDate")[0].value;
    const offerPrice = document.getElementsByName("offerPrice")[0].value;
    const minimumPrice = document.getElementsByName("minimumPrice")[0].value;

    const data = {
      couponName: name,
      startDate: startDate,
      endDate: endDate,
      offerPrice: offerPrice,
      minimumPrice: minimumPrice,
    };

    fetch("/admin/createCoupon", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(data),
    })
      .then((response) => {
        if (response.ok) {
          return response.json();
        }
        throw new Error("Failed to create coupon");
      })
      .then((data) => {
        Swal.fire({
          icon: "success",
          title: "Coupon Created",
          text: "The coupon has been successfully created!",
          confirmButtonText: "OK",
        }).then(() => {
          location.reload();
        });
      })
      .catch((error) => {
        Swal.fire({
          icon: "error",
          title: "Error",
          text: "Failed to create coupon. Please try again.",
          confirmButtonText: "OK",
        });
        console.error("Error creating coupon:", error);
      });
  }

  function deleteCoupon(id) {
    Swal.fire({
      title: "Are you sure?",
      text: "You won't be able to revert this!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#d33",
      cancelButtonColor: "#3085d6",
      confirmButtonText: "Yes, delete it!",
    }).then((result) => {
      if (result.isConfirmed) {
        fetch("/admin/deleteCoupon?id=" + id, {
          method: "GET",
        })
          .then((response) => {
            if (response.ok) {
              Swal.fire({
                icon: "success",
                title: "Deleted!",
                text: "The coupon has been deleted.",
                confirmButtonText: "OK",
              }).then(() => {
                location.reload();
              });
            } else {
               Swal.fire({
                icon: "error",
                title: "Error",
                text: "Failed to delete coupon.",
               });
            }
          })
          .catch((error) => {
            console.error("Error deleting coupon:", error);
                 Swal.fire({
                icon: "error",
                title: "Error",
                text: "Something went wrong.",
               });
          });
      }
    });
  }
  
  function toggleStatus(id) {
      fetch("/admin/editCouponStatus?id=" + id, {
          method: "GET",
      })
      .then((response) => {
          if (response.ok) {
              const search = $('#couponSearchInput').val();
              const currentPage = $('.page-item.active .page-link').text() || 1;
              updateCouponTable(search, currentPage);
          } else {
             Swal.fire({
              icon: "error",
              title: "Error",
              text: "Failed to update status.",
             });
          }
      })
      .catch((error) => {
          console.error("Error updating status:", error);
           Swal.fire({
              icon: "error",
              title: "Error",
              text: "Something went wrong.",
           });
      });
  }

  // Define search functions globally so they are available immediately
  function updateCouponTable(search, page) {
      const url = `/admin/coupon?search=${search}&page=${page || 1}`;
      // Using .load() but targeting the container children precisely
      $('#couponTableContainer').load(url + ' #couponTableContainer > *', function(response, status, xhr) {
          if (status === "error") {
              console.error("Error loading coupon table:", xhr.status, xhr.statusText);
          }
      });
  }

  function clearCouponSearch() {
      $('#couponSearchInput').val('');
      $('#clearCouponBtn').hide();
      updateCouponTable('', 1);
  }

  function handlePagination(e, page) {
      e.preventDefault();
      const search = $('#couponSearchInput').val();
      updateCouponTable(search, page);
  }

  // Live Search for Coupons
  $(document).ready(function() {
      let timeout = null;
      $(document).on('input', '#couponSearchInput', function() {
          const query = $(this).val();
          if (query.length > 0) {
              $('#clearCouponBtn').show();
          } else {
              $('#clearCouponBtn').hide();
          }
          clearTimeout(timeout);
          timeout = setTimeout(function() {
              updateCouponTable(query, 1);
          }, 300);
      });
  });
</script>
<%- include("../../views/partials/admin/footer") %>
