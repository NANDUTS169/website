<%- include('../../views/partials/admin/header') %>

<section class="content-main">
  <div class="content-header">
    <div>
      <h2 class="content-title card-title">Order Detail</h2>
      <p class="small text-muted">Order details, update status & verify returns</p>
    </div>
    <div>
      <a href="/admin/orderlist" class="btn btn-light">← Back to orders</a>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <div class="row gx-4">
        <div class="col-md-6">
          <h5>Order</h5>
          <p><strong>Order ID:</strong> <%= order.orderId %></p>
          <p><strong>Placed:</strong> <%= new Date(order.createdAt || order.invoiceDate || Date.now()).toLocaleString() %></p>
          <p><strong>Payment:</strong> <%= order.paymentMethod %> — <%= order.paymentStatus %></p>
          <p><strong>Status:</strong> <span id="currentStatus"><%= order.status %></span></p>
        </div>

        <div class="col-md-6">
          <h5>Customer</h5>
          <p><strong>Name:</strong> <%= order.userId && order.userId.name ? order.userId.name : (order.shippingAddress && order.shippingAddress.name ? order.shippingAddress.name : 'Guest') %></p>
          <p><strong>Email:</strong> <%= order.userId && order.userId.email ? order.userId.email : '' %></p>
          <p><strong>Phone:</strong> <%= order.userId && order.userId.phone ? order.userId.phone : (order.shippingAddress && order.shippingAddress.phone ? order.shippingAddress.phone : '') %></p>
          <% if (order.userId && typeof order.userId.walletBalance !== 'undefined') { %>
            <p><strong>Wallet:</strong> ₹<%= Number(order.userId.walletBalance || 0).toFixed(2) %></p>
          <% } %>
        </div>
      </div>

      <hr/>

      <div class="row gx-4">
        <div class="col-md-6">
          <h5>Shipping Address</h5>
          <% if (order.shippingAddress) { %>
            <p>
              <strong><%= order.shippingAddress.name || '' %></strong><br/>
              <%= order.shippingAddress.addressType ? order.shippingAddress.addressType + ', ' : '' %>
              <%= order.shippingAddress.city ? order.shippingAddress.city + ', ' : '' %>
              <%= order.shippingAddress.state ? order.shippingAddress.state + ', ' : '' %>
              <%= order.shippingAddress.pincode ? order.shippingAddress.pincode : '' %><br/>
              <%= order.shippingAddress.phone ? 'Phone: ' + order.shippingAddress.phone : '' %>
            </p>
          <% } else { %>
            <p class="text-muted">No shipping address recorded.</p>
          <% } %>
        </div>

        <div class="col-md-6">
          <h5>Totals</h5>
          <p><strong>Subtotal:</strong> ₹<%= (order.totalPrice || 0).toFixed(2) %></p>
          <p><strong>Discount:</strong> ₹<%= (order.discount || 0).toFixed(2) %></p>
          <p><strong>Final Amount:</strong> ₹<%= (order.finalAmount || order.totalPrice || 0).toFixed(2) %></p>
        </div>
      </div>

      <hr/>

      <div>
        <h5>Change Order Status</h5>
        <div class="d-flex align-items-start gap-2 mb-3">
          <select id="statusSelect" class="form-select" style="max-width: 260px;">
            <option value="Pending" <%= order.status === 'Pending' ? 'selected' : '' %>>Pending</option>
            <option value="Processing" <%= order.status === 'Processing' ? 'selected' : '' %>>Processing</option>
            <option value="Shipped" <%= order.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
            <option value="Delivered" <%= order.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
            <option value="Cancelled" <%= order.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
            <option value="Return Requested" <%= order.status === 'Return Requested' ? 'selected' : '' %>>Return Requested</option>
            <option value="Returned" <%= order.status === 'Returned' ? 'selected' : '' %>>Returned</option>
          </select>

          <input id="statusNote" class="form-control" placeholder="Optional note" style="max-width: 400px;" />
          <button id="changeStatusBtn" class="btn btn-primary">Update</button>
        </div>
        <div id="statusMsg" class="small text-success" style="display:none;"></div>
      </div>

      <hr/>

      <h5>Items</h5>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>Product</th>
              <th>SKU</th>
              <th>Qty</th>
              <th>Price</th>
              <th>Subtotal</th>
              <th>Return</th>
            </tr>
          </thead>
          <tbody>
            <% (order.orderedItems || []).forEach(function(it) { %>
              <tr>
                <td><%= it.product && it.product.name ? it.product.name : 'Product' %></td>
                <td><%= it.product && it.product.sku ? it.product.sku : '-' %></td>
                <td><%= it.quantity %></td>
                <td>₹<%= (it.price || 0).toFixed(2) %></td>
                <td>₹<%= ((it.price || 0) * (it.quantity || 1)).toFixed(2) %></td>
                <td>
                  <% if (it.returnRequested && !it.returnVerified) { %>
                    <button class="btn btn-sm btn-success verifyReturnBtn" data-productid="<%= it.product ? it.product._id : '' %>">Approve</button>
                    <button class="btn btn-sm btn-danger rejectReturnBtn" data-productid="<%= it.product ? it.product._id : '' %>">Reject</button>
                  <% } else if (it.returnVerified) { %>
                    <span class="text-success">Approved</span>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <hr/>

      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h6>Order Notes</h6>
          <% if (order.returnReason) { %>
            <p class="text-muted"><strong>Return reason:</strong> <%= order.returnReason %></p>
          <% } else { %>
            <p class="text-muted">No special notes</p>
          <% } %>
        </div>

        <div class="text-end">
          <a href="/admin/orderlist" class="btn btn-light">Back</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function(){
    var orderId = "<%= order._id %>";

    function showMsg(elId, text, ok) {
      var el = document.getElementById(elId);
      if (!el) return;
      el.style.display = 'block';
      el.style.color = ok ? 'green' : 'red';
      el.innerText = text;
      setTimeout(function(){ el.style.display = 'none'; }, 2500);
    }

    var changeBtn = document.getElementById('changeStatusBtn');
    if (changeBtn) {
      changeBtn.addEventListener('click', function(){
        var status = document.getElementById('statusSelect').value;
        var note = document.getElementById('statusNote').value;
        changeBtn.disabled = true;
        fetch('/admin/order/' + orderId + '/status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: status, note: note })
        }).then(function(r){ return r.json(); })
        .then(function(j){
          changeBtn.disabled = false;
          if (j && j.ok) {
            document.getElementById('currentStatus').innerText = status;
            showMsg('statusMsg', 'Status updated', true);
          } else {
            showMsg('statusMsg', 'Error: ' + (j && j.msg ? j.msg : 'Unknown'), false);
          }
        }).catch(function(err){
          changeBtn.disabled = false;
          showMsg('statusMsg', 'Server error', false);
        });
      });
    }

    // verify and reject return buttons
    var approveBtns = document.querySelectorAll('.verifyReturnBtn');
    approveBtns.forEach(function(btn){
      btn.addEventListener('click', function(){
        var productId = btn.getAttribute('data-productid');
        var refundTo = prompt('Refund to (wallet/none). Type wallet or none', 'wallet') || 'wallet';
        btn.disabled = true;
        fetch('/admin/order/' + orderId + '/return-verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'approve', productId: productId, refundTo: refundTo })
        }).then(function(r){ return r.json(); })
        .then(function(j){
          btn.disabled = false;
          if (j && j.ok) {
            alert('Return approved. Refunded: ' + (j.refundAmount || 0));
            window.location.reload();
          } else {
            alert('Error: ' + (j && j.msg ? j.msg : 'unknown'));
          }
        }).catch(function(err){
          btn.disabled = false;
          alert('Server error');
        });
      });
    });

    var rejectBtns = document.querySelectorAll('.rejectReturnBtn');
    rejectBtns.forEach(function(btn){
      btn.addEventListener('click', function(){
        var productId = btn.getAttribute('data-productid');
        if (!confirm('Reject this return request?')) return;
        btn.disabled = true;
        fetch('/admin/order/' + orderId + '/return-verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'reject', productId: productId })
        }).then(function(r){ return r.json(); })
        .then(function(j){
          btn.disabled = false;
          if (j && j.ok) {
            alert('Return rejected');
            window.location.reload();
          } else {
            alert('Error: ' + (j && j.msg ? j.msg : 'unknown'));
          }
        }).catch(function(err){
          btn.disabled = false;
          alert('Server error');
        });
      });
    });

  })();
</script>

<%- include('../../views/partials/admin/footer') %>
