<%-include("../../views/partials/admin/header")%>

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Users</h2>
            <p>Manage your users here.</p>
        </div>
        <div class="col-search">
            <form action="" method="get" class="d-inline" onsubmit="updateTable($('#searchInput').val(), 1); return false;">
                <div class="input-group input-group-sm border border-1 border-grey rounded-pill shadow-sm" style="width: 500px; background-color: white; padding: 3px;">
                    <input type="text" class="form-control border-0 rounded-pill ms-2" placeholder="Search by name or email" name="search" id="searchInput" autocomplete="off" value="<%= locals.search || '' %>" style="box-shadow: none;">
                    <button class="btn border-0" type="button" onclick="clearSearch()" id="clearButton" style="display: <%= locals.search ? 'inline-block' : 'none' %>;">
                        <i class="material-icons md-close"></i>
                    </button>
                    <button class="btn btn-primary rounded-pill px-4 ms-2" type="submit">Search</button>
                </div>
            </form>
        </div>
    </div>
    <div id="userTableContainer">
    <div class="card mb-4 mt-4">
        <header class="card-header">
            <h4 class="card-title">User Listings</h4>
        </header>
        <!-- card-header end// -->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">#ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Status</th>
                            <th scope="col">Joined</th>
                            <th scope="col" class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody> 
                        <% if(users.length > 0) {%>
                            <% for(let i=0;i<users.length;i++) { %>
                        <tr>
                            <td><%= i+1 %></td>
                            <td><b><%= users[i].name %></b></td>
                            <td><%= users[i].email %></td>
                            <td><span class="badge rounded-pill alert-success">Active</span></td>
                            <td>03.12.2020</td>
                            <td class="text-end">
                                <% if(users[i].isBlocked) {%>
                                    <button class="btn btn-md rounded font-sm" onclick="confirmAction('/admin/UnblockCustomer?id=<%=users[i]._id%>', 'unblock')">Unblock</button>
                                <% }else { %>
                                    <button class="btn btn-md rounded font-sm" onclick="confirmAction('/admin/blockCustomer?id=<%=users[i]._id%>', 'block')">Block</button>
                                <% } %>
                            </td>
                        </tr>
                        <% } %>
                        <% } %>
                        <!-- Add more rows as needed -->
                    </tbody>
                </table>
            </div>
            <!-- table-responsive //end -->
        </div>
        <!-- card-body end// -->
    </div>
    <!-- card end// -->
    <div class="pagination-area mt-15 mb-50">
        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-start">
                <% if (currentPage > 1) { %>
                    <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage - 1 %>&search=<%= locals.search || '' %>" onclick="handlePagination(event, '<%= currentPage - 1 %>')">&laquo;</a>
                    </li>
                <% } %>
    
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %>&search=<%= locals.search || '' %>" onclick="handlePagination(event, '<%= i %>')"><%= i %></a>
                    </li>
                <% } %>
    
                <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage + 1 %>&search=<%= locals.search || '' %>" onclick="handlePagination(event, '<%= currentPage + 1 %>')">&raquo;</a>
                    </li>
                <% } %>
            </ul>
        </nav>
    </div>
    </div>
    
</section>
<!-- content-main end// -->

<%-include("../../views/partials/admin/footer")%>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function confirmAction(url, actionType) {
        Swal.fire({
            title: 'Are you sure?',
            text: `Do you really want to ${actionType} this user?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: `Yes, ${actionType} it!`
        }).then((result) => {
            if (result.isConfirmed) {
                // Instead of redirecting, we can use AJAX or keep simple redirect if preferred.
                // For consistency with other pages, let's keep simple redirect or update dynamic table.
                fetch(url).then(res => {
                    if(res.ok) {
                        updateTable($('#searchInput').val(), $('.page-item.active .page-link').first().text() || 1);
                        Toast.fire({
                            icon: 'success',
                            title: `User ${actionType}ed successfully`
                        });
                    }
                });
            }
        });
    }

    const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true
    });

    // Live Search Logic
    $(document).ready(function() {
        let timeout = null;
        $(document).on('input', '#searchInput', function() {
            const query = $(this).val();
            if (query.length > 0) {
                $('#clearButton').show();
            } else {
                $('#clearButton').hide();
            }
            clearTimeout(timeout);
            timeout = setTimeout(function() {
                updateTable(query, 1);
            }, 300);
        });
    });

    function updateTable(search, page) {
        const url = `/admin/users?search=${search}&page=${page || 1}`;
        $('#userTableContainer').load(url + ' #userTableContainer > *');
    }

    function clearSearch() {
        $('#searchInput').val('');
        $('#clearButton').hide();
        updateTable('', 1);
    }

    function handlePagination(e, page) {
        e.preventDefault();
        const search = $('#searchInput').val();
        updateTable(search, page);
    }

</script>